amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

local checks = new Mapping<String, Step> {
  ["markdown"] {
    glob = List("*.md", "docs/**/*.md")
    check = "rumdl check {{files}}"
    fix = "rumdl fmt {{files}}"
  }

  ["shellcheck"] {
    glob = List("bin/**", "tests/**/*.sh")
    check = "shellcheck {{files}}"
  }

  ["shfmt"] {
    glob = List("bin/**", "tests/**/*.sh")
    check = "shfmt -d -i 2 -ci {{files}}"
    fix = "shfmt -w -i 2 -ci {{files}}"
  }

  ["actionlint"] {
    glob = ".github/workflows/*.yml"
    check = "actionlint {{files}}"
  }

  ["zizmor"] {
    glob = ".github/workflows/*.yml"
    check = "zizmor {{files}}"
  }

  ["lychee"] {
    check = "lychee --config lychee.toml ."
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = checks
  }

  ["check"] {
    steps = checks
  }

  ["fix"] {
    fix = true
    steps = checks
  }
}
