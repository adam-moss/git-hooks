amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

local checks = new Mapping<String, Step> {
  ["markdown"] {
    glob = List("*.md", "docs/**/*.md")
    check = "rumdl check {{files}}"
    fix = "rumdl fmt {{files}}"
  }

  ["shellcheck"] {
    glob = List("bin/**", "tests/**/*.sh")
    check = "shellcheck {{files}}"
  }

  ["shfmt"] {
    glob = List("bin/**", "tests/**/*.sh")
    check = "shfmt -d -i 2 -ci {{files}}"
    fix = "shfmt -w -i 2 -ci {{files}}"
  }

  ["actionlint"] {
    glob = ".github/workflows/*.yml"
    check = "actionlint {{files}}"
  }

  ["zizmor"] {
    glob = ".github/workflows/*.yml"
    check = "zizmor {{files}}"
  }

  ["lychee"] {
    profiles = List("slow")
    check = "lychee --config lychee.toml ."
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = checks
  }

  ["check"] {
    steps = checks
  }

  ["fix"] {
    fix = true
    steps = checks
  }

  // Commit metadata is prepared before the editor opens. HK_SKIP_STEPS is
  // still available to the skipped-check trailer command.
  ["prepare-commit-msg"] {
    fix = true
    steps {
      ["config-trailer"] {
        fix = "git-hooks trailers add-config-trailer {{commit_msg_file}}"
      }
      ["skipped-trailer"] {
        fix = "git-hooks trailers add-skipped-trailer {{commit_msg_file}}"
      }
    }
  }

  // Load and unload the configured SSH signing identity around commits.
  ["commit-msg"] {
    fix = true
    steps {
      ["add-ssh-key"] {
        condition = "exec_ok('git config --get user.signingKey')"
        fix = "git-hooks signing add-ssh-key"
      }
    }
  }

  ["post-commit"] {
    fix = true
    steps {
      ["remove-ssh-key"] {
        condition = "exec_ok('git config --get user.signingKey')"
        fix = "git-hooks signing remove-ssh-key"
      }
    }
  }

  // hk exposes the pre-push ref updates as hook_stdin. Pass them through
  // stdin rather than interpolating untrusted ref names into a shell command.
  ["pre-push"] {
    steps {
      ["block-push-skip-ci"] {
        stdin = "{{hook_stdin}}"
        check = "git-hooks community-health block-push-skip-ci"
      }
    }
  }
}
