amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

local checks = new Mapping<String, Step> {
  ["markdown"] = (Builtins.rumdl) {
    fix = "rumdl fmt {{files}}"
  }
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = (Builtins.shfmt) {
    exclude = List("spec/**/*.sh")
    check = "shfmt -d -i 2 -ci {{files}}"
    fix = "shfmt -w -i 2 -ci {{files}}"
  }
  ["actionlint"] = Builtins.actionlint
  ["zizmor"] = Builtins.zizmor
  ["lychee"] = (Builtins.lychee) {
    profiles = List("slow")
    exclude = List(
      ".editorconfig", ".gitattributes", ".gitignore",
      ".github/pull_request_template.md", ".github/**/*.yml",
      ".github/**/*.yaml", "bin/**", "lib/**", "mise-tasks/**",
      "spec/**", "*.toml", "*.pkl", "*.json", "*.jsonc"
    )
  }
  ["newlines"] = Builtins.newlines
  ["byte-order-marker"] = Builtins.byte_order_marker
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-merge-conflict"] = Builtins.check_merge_conflict

  // Scan staged content before each commit. CI separately scans all Git history.
  ["betterleaks-staged"] {
    condition = "!exec_ok('git diff --cached --quiet')"
    check = "git diff --cached --no-ext-diff --unified=0 | betterleaks stdin --git-diff --redact"
  }

  // Run the full suite in the slow profile; CI separately tests bash and zsh.
  ["shellspec"] {
    glob = "spec/**/*.sh"
    profiles = List("slow")
    check = "shellspec"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = checks
  }
  ["check"] {
    steps = checks
  }
  ["fix"] {
    fix = true
    steps = checks
  }
  ["prepare-commit-msg"] {
    fix = true
    steps {
      ["config-trailer"] {
        fix = "git-hooks trailers add-config-trailer {{commit_msg_file}}"
      }
      ["skipped-trailer"] {
        fix = "git-hooks trailers add-skipped-trailer {{commit_msg_file}}"
      }
      ["add-ssh-key"] {
        condition = "exec_ok('git config --get gpg.format | grep -qx ssh') and exec_ok('git config --get user.signingKey')"
        fix = "git-hooks signing add-ssh-key"
      }
    }
  }
  ["post-commit"] {
    fix = true
    steps {
      ["remove-ssh-key"] {
        condition = "exec_ok('git config --get gpg.format | grep -qx ssh') and exec_ok('git config --get user.signingKey')"
        fix = "git-hooks signing remove-ssh-key"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["block-push-skip-ci"] {
        env {
          ["HK_HOOK_STDIN"] = "{{hook_stdin}}"
        }
        check = "git-hooks community-health block-push-skip-ci"
      }
    }
  }
}
